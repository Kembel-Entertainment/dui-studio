{
  "name": "dui-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "package": "tauri build",
    "format": "prettier --write src tests scripts/*.mjs *.ts *.json *.md docs examples src-tauri/tauri.conf.json src-tauri/capabilities",
    "format:check": "prettier --check src tests scripts/*.mjs *.ts *.json *.md docs examples src-tauri/tauri.conf.json src-tauri/capabilities",
    "runtime": "node scripts/runtime.mjs",
    "setup:dui": "node scripts/fetch-dui.mjs"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@lezer/xml": "^1.0.6",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "codemirror": "^6.0.2",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "8.3.2",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@12.8.1",
  "description": "Work-in-progress desktop authoring and native preview for DUI projects",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kembel-Entertainment/dui-studio.git"
  },
  "engines": {
    "node": ">=24"
  }
}
